# =================================================================
# VIBERIDE PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# 1. MongoDB Connection URI (Atlas Replica Set required in production)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/viberide?retryWrites=true&w=majority"

# 2. NextAuth.js Configuration
AUTH_SECRET="place-your-32-character-random-secret-here"
NEXTAUTH_URL="https://viberide-flame.vercel.app"

# 3. S3-Compatible Production Storage (Cloudflare R2, AWS S3, etc.)
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL=""

# 4. SMTP Email Configuration (Nodemailer for OTP & transactional emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-app-password"
SMTP_FROM="\"Viberide\" <noreply@viberide.in>"
